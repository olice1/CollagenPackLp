# ==========================================
# AUREVA CONFIGURATION (.env)
# ==========================================

# Server Port (optional, default 3000)
PORT=3000

# Public URL of the deployed application (used for webhooks, canonical links, og:url)
PUBLIC_SITE_URL=https://aureva.ma

# ==========================================
# 1. GOOGLE SHEETS CONFIGURATION
# ==========================================
# ID of your Google Sheet from the URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=1NWTDQlS7zmmNQLUUn5toz1sryS4UwvEPWY7NyJXwA6A

# Google Sheet tab name (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Method A (Recommended): Paste the full Service Account JSON content as a single line string
GOOGLE_SERVICE_ACCOUNT_JSON=

# Method B: Provide individual credentials from your Service Account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==========================================
# 2. TELEGRAM BOT CONFIGURATION
# ==========================================
# Bot token received from @BotFather
TELEGRAM_BOT_TOKEN=8797833092:AAEy-nT_tzsNrFy5c23jMPgwc3kh0E8fmPU

# Chat ID or Group ID where new order notifications should be sent
TELEGRAM_CHAT_ID=-1001234567890

# Comma-separated list of authorized Telegram User IDs permitted to change order statuses
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=7864140160

# Secret token string to verify incoming webhook requests from Telegram (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_random_secure_webhook_secret_here


# ==========================================
# 3. META ADS TRACKING (PIXEL & CAPI)
# ==========================================
# Meta Pixel ID (e.g. 123456789012345)
META_PIXEL_ID=2176488913254071

# Meta Conversions API Access Token (System User Token from Events Manager)
META_CONVERSIONS_API_TOKEN=EAAXhbW8hKh8BSZCYGupxh0Cz0YymrEKcquu6q3ufbrAqsGxmJH4HZBDdcwUPEVSaBmiK2NpsCp9A3pBExVr9SwOMbCZC4Fspeq4w1iu5yyiC6AAN28qmsB8yPr0WcHMZAF3IMpvjDzZC0iQZCYde65NcZAgWkzDq8r5plZAMEbKZCVRHlc4xhti5VOZBKYGuGxAyUyfwZDZD

